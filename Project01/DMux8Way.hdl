// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in, sel=sel[2], a=pin1, b=pin4);
    DMux(in=pin1, sel=sel[1], a=pin2, b=pin3);
    DMux(in=pin2, sel=sel[0], a=a, b=b);
    DMux(in=pin3, sel=sel[0], a=c, b=d);
    DMux(in=pin4, sel=sel[1], a=pin5, b=pin6);
    DMux(in=pin5, sel=sel[0], a=e, b=f);
    DMux(in=pin6, sel=sel[0], a=g, b=h);
}