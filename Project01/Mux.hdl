// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    // (a And Not(sel)) Or (b And sel)
    Not(in=sel, out=notsel);
    And(a=a, b=notsel, out=inAnd1);
    And(a=sel, b=b, out=inAnd2);
    Or(a=inAnd1, b=inAnd2, out=out);
}