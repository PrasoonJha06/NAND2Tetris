// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    Or(a=in[0], b= in[1], out=pin1);
    Or(a=pin1, b= in[2], out=pin2);
    Or(a=pin2, b= in[3], out=pin3);
    Or(a=pin3, b= in[4], out=pin4);
    Or(a=pin4, b= in[5], out=pin5);
    Or(a=pin5, b= in[6], out=pin6);
    Or(a=pin6, b= in[7], out=out);
}