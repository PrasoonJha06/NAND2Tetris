// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    /*
    This will make sure that load is 1 only for the 
    register where we have to write.
    Now if the load is already 0, all values will be 0
    and nothing will be written.
    */
    DMux8Way(in=load, sel=address, 
             a=a, b=b, c=c, d=d,
             e=e, f=f, g=g, h=h);
    
    /*
    All registers are being fed loads. In case of load 1,
    only the one with the selected address will get that.
    While in the case of load 0, no one will get load 1
    */
    Register(in=in, load=a, out=pin0);
    Register(in=in, load=b, out=pin1);
    Register(in=in, load=c, out=pin2);
    Register(in=in, load=d, out=pin3);
    Register(in=in, load=e, out=pin4);
    Register(in=in, load=f, out=pin5);
    Register(in=in, load=g, out=pin6);
    Register(in=in, load=h, out=pin7);

    /*
    Now time for reading.
    We are feeding all register outputs to a Mux which
    will output only the output of the selected register.
    */
    Mux8Way16(a=pin0, b=pin1, c=pin2, d=pin3,
              e=pin4, f=pin5, g=pin6, h=pin7,
              sel=address, out=out);
}