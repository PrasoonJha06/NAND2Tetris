// File name: projects/3/b/RAM512.hdl
/**
 * Memory of 512 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    /*
    Every other RAM is just larger, the structure
    remains identical.
    */
    Mux16(a[0..8]=address, a[9..15]=false, b=false,
          sel=false, out[0..5]=findRAM8, 
          out[6..8]=findRAM64, out[9..15]=useless);

    DMux8Way(in=load, sel=findRAM64, 
             a=a, b=b, c=c, d=d,
             e=e, f=f, g=g, h=h);
    
    RAM64(in=in, load=a, address=findRAM8, out=pin0);
    RAM64(in=in, load=b, address=findRAM8, out=pin1);
    RAM64(in=in, load=c, address=findRAM8, out=pin2);
    RAM64(in=in, load=d, address=findRAM8, out=pin3);
    RAM64(in=in, load=e, address=findRAM8, out=pin4);
    RAM64(in=in, load=f, address=findRAM8, out=pin5);
    RAM64(in=in, load=g, address=findRAM8, out=pin6);
    RAM64(in=in, load=h, address=findRAM8, out=pin7);

    Mux8Way16(a=pin0, b=pin1, c=pin2, d=pin3,
              e=pin4, f=pin5, g=pin6, h=pin7,
              sel=findRAM64, out=out);
}