// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    Mux16(a[0..11] = address, a[12..15]=false, b=false,
          sel=false, out[0..8]=findRAM64, 
          out[9..11]=findRAM512, out[12..15]=useless);

    DMux8Way(in=load, sel=findRAM512, 
             a=a, b=b, c=c, d=d,
             e=e, f=f, g=g, h=h);
    
    RAM512(in=in, load=a, address=findRAM64, out=pin0);
    RAM512(in=in, load=b, address=findRAM64, out=pin1);
    RAM512(in=in, load=c, address=findRAM64, out=pin2);
    RAM512(in=in, load=d, address=findRAM64, out=pin3);
    RAM512(in=in, load=e, address=findRAM64, out=pin4);
    RAM512(in=in, load=f, address=findRAM64, out=pin5);
    RAM512(in=in, load=g, address=findRAM64, out=pin6);
    RAM512(in=in, load=h, address=findRAM64, out=pin7);

    Mux8Way16(a=pin0, b=pin1, c=pin2, d=pin3,
              e=pin4, f=pin5, g=pin6, h=pin7,
              sel=findRAM512, out=out);
}