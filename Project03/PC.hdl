// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    /*
    This one turned out to be harder than I thought.
    However the final solution ended up being remarkably
    simple. Look at the circuit diagram to understand how
    is it working.
    */

    // inc condition
    Not(in=reset, out=notReset);
    Not(in=load, out=notLoad);
    And(a=notReset, b=notLoad, out=and0);
    And(a=and0, b=inc, out=incCond);

    // load condition
    Or(a=reset, b=load, out=or0);
    Or(a=or0, b=inc, out=loadCond);

    // First Mux
    Mux16(a=in, b=false, sel=reset, out=pin0);

    // Second Mux
    Mux16(a=pin0, b=incremented, sel=incCond, out=pin1);

    // Register and Incrementer
    Register(in=pin1, load=loadCond, out=pin2, out=out);
    Inc16(in=pin2, out=incremented);
}