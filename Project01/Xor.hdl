// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    // a Xor b = (Not(a) And b) Or (a And Not(b))
    Not(in=a, out=nota);
    Not(in=b, out=notb);
    And(a=nota, b=b, out=inAnd1);
    And(a=a, b=notb, out=inAnd2);
    Or(a=inAnd1, b=inAnd2, out=out);
}